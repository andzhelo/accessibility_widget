{
  "name": "@andzhelo/accessibility-widget",
  "version": "0.1.0",
  "description": "A small, dependency-free accessibility menu for any site: text size, contrast, link highlighting, readable font, spacing, stop animations. Hebrew and English built in, RTL aware.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "demo": "npx --yes serve -l 4400 ."
  },
  "keywords": [
    "accessibility",
    "a11y",
    "widget",
    "wcag",
    "is-5568",
    "hebrew",
    "rtl"
  ],
  "author": "Evgeny Andzhelo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andzhelo/accessibility_widget"
  }
}
